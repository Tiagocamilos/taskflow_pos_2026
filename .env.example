# =============================================================================
# TaskFlow - Modelo de Configuração de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com seus valores. NUNCA commite o .env.
# Gerar a chave: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

TASKFLOW_SECRET_KEY=
TASKFLOW_ADMIN_PASSWORD=


